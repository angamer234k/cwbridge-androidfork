                {"id": "87", "text": ["Run function", {"value": "call", "t": "string", "l": "function"}, {"value": [], "t": "tuple"}, "→", {"value": "4", "t": "string", "l": "variable"}], "globalid": "bj"},
                {"id": "115", "text": ["Return", {"value": "{4}", "t": "string", "l": "any"}], "globalid": "bk"}
