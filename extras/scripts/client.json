{
  "title": "CWBridge client (s.eof.rbx)",
  "description": "Public client protocol + CatWeb UI/script outline. Host = s.eof.rbx. Server script is NOT published.",
  "host": "s.eof.rbx",
  "host_page": "s.eof.rbx/main",
  "protocol": {
    "request": "REQ|<id>|<payload>",
    "payload_examples": [
      "alive",
      "enter",
      "load.mykey.domain.rbx",
      "paste.hello",
      "weather.London",
      "storeinfo.domain.rbx"
    ],
    "response_simple": "RES|<id>|OK|<text>",
    "response_error": "RES|<id>|ERR|<reason>",
    "response_timeout": "RES|<id>|TIMEOUT",
    "response_chunked": {
      "part": "RES|<id>|PART|<index>|<total>|<chunk>",
      "note": "index is 0-based. Concatenate chunk fields in order until all total parts arrive. Keep each broadcast under ~900 bytes (limit 979).",
      "example": [
        "RES|a1|PART|0|3|hello ",
        "RES|a1|PART|1|3|world ",
        "RES|a1|PART|2|3|!"
      ]
    },
    "id_rules": "2-6 alphanumeric chars. Prefer one pending request at a time.",
    "rate_limit": "Cross-site uncached ~4 per 20s — do not spam."
  },
  "favicon": "16944769468",
  "background": "#0b0e13",
  "webcontent": [
    {
      "class": "Frame",
      "globalid": "rt",
      "alias": "root",
      "size": "{1,0},{1,0}",
      "position": "{0,0},{0,0}",
